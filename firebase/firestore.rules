rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo lee/escribe su propio documento (coopId, tokens)
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.email_verified == true;
    }

    match /coops/{coopId} {
      // Cualquier usuario verificado puede crear un gallinero donde él sea el dueño
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members == [request.auth.uid];

      // Buscar por código para unirse (consulta con limit 1)
      allow list: if request.auth != null
                  && request.auth.token.email_verified == true
                  && request.query.limit <= 1;

      allow get: if request.auth != null && request.auth.uid in resource.data.members;

      // Los miembros pueden editar el gallinero; además cualquiera puede añadirse a sí mismo
      allow update: if request.auth != null && (
          request.auth.uid in resource.data.members
          || (request.resource.data.members.hasAll(resource.data.members)
              && request.resource.data.members.size() == resource.data.members.size() + 1
              && request.auth.uid in request.resource.data.members)
      );

      match /history/{id} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/coops/$(coopId)).data.members;
        allow write: if false; // solo la Cloud Function (Admin SDK) escribe el historial
      }
    }
  }
}
